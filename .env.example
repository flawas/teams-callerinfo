# Caller Info – Konfiguration
# Die App läuft komplett im Teams-Client. Diese Werte landen beim Build (npm run build)
# in dist/config.json bzw. beim Paketieren (npm run package:app) im Teams-Manifest.

# ---------- Hosting & Teams-App-Paket ----------
# Adresse, unter der der Inhalt von dist/ statisch gehostet wird (ohne / am Ende)
# z.B. GitHub Pages: https://flawas.github.io/teams-callerinfo
PUBLIC_URL=
# Application (Client) ID einer Entra-App-Registrierung. Teams verlangt sie für die
# Anruf-Berechtigung (RSC) im Manifest – ohne Secrets, Rollen oder API.
CLIENT_ID=
# Feste GUID der Teams-App – einmal erzeugen und nie mehr ändern
TEAMS_APP_ID=
# Herausgeber, wie er in Teams angezeigt wird (leer = "Caller Info")
DEVELOPER_NAME=
# Optional, sonst PUBLIC_URL/caller.html
DEVELOPER_URL=

# ---------- Allgemein ----------
# Ländervorwahl für nationale Nummern (041 …), ohne +
DEFAULT_COUNTRY_CODE=41
# Technische Fehlermeldungen der Quellen im Panel anzeigen
SHOW_ERRORS=true

# ---------- tel.search.ch (Telefonbuch Schweiz) ----------
SEARCHCH_ENABLED=true
# Optional. Ohne Key nur Name/Adresse/Link. ACHTUNG: Ein Key landet in config.json und ist
# für alle sichtbar, die die App-URL kennen (siehe README). Key: https://search.ch/tel/api/getkey
SEARCHCH_API_KEY=
# Nur abfragen, wenn keine andere Quelle (sources.json) einen Treffer hat
SEARCHCH_FALLBACK_ONLY=true
# Ergebnisse pro Nummer im Browser zwischenspeichern
SEARCHCH_CACHE_HOURS=24
SEARCHCH_MAX_MATCHES=3
SEARCHCH_PRIVAT=true
SEARCHCH_FIRMA=true
SEARCHCH_LANG=de

# ---------- Lokale Entwicklung ----------
# npm run dev liefert die App unter http://localhost:3978/caller.html aus
PORT=3978
# Für Tests mit dem Mock (npm run mock): SEARCHCH_API_URL=http://localhost:4000/tel/api/
SEARCHCH_API_URL=
